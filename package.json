{
  "name": "parabank_pw_ts",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation for ParaBank (E2E, API, security)",
  "scripts": {
  "test": "playwright test -c config/playwright.config.ts",
  "test:chromium": "playwright test -c config/playwright.config.ts --project=chromium",
  "test:headed": "playwright test -c config/playwright.config.ts --project=chromium --headed",
  "test:debug": "playwright test -c config/playwright.config.ts --project=chromium --debug",
  "test:ui": "playwright test -c config/playwright.config.ts --ui",
  "test:smoke": "playwright test -c config/playwright.config.ts --project=chromium --grep @smoke",
  "test:regression": "playwright test -c config/playwright.config.ts --project=chromium --grep @regression",
  "test:api": "playwright test -c config/playwright.config.ts --project=api",
  "test:security": "playwright test -c config/playwright.config.ts --project=chromium --grep @security",
  "report": "playwright show-report reports/html-report",
  "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
  "allure:open": "allure open reports/allure-report",
  "codegen": "playwright codegen https://parabank.parasoft.com/parabank/",
  "prepare": "husky"
},

  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zod": "^4.5.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
}